<?xml version="1.0" encoding="utf-8" ?>
<component name="MainScene" extends="Scene">
  <interface>
    <field id="launchArgs" type="assocarray" />
    <field id="inputArgs" type="assocarray" alwaysNotify="true" />
    <field id="memoryWarning" type="boolean" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/MainScene.brs" />
  <children>
    <Video id="video" translation="[0,0]" width="1280" height="720" />

    <!-- Barra de informações -->
    <Group id="info" visible="false">
      <Poster translation="[0,0]" width="1280" height="100" uri="pkg:/images/grad_top.png" />
      <Label id="clock" translation="[1000,30]" width="216" height="38" horizAlign="right" vertAlign="center" color="0xFFFFFFFF" />
      <Poster translation="[0,440]" width="1280" height="280" uri="pkg:/images/grad_bottom.png" />
      <Poster translation="[64,590]" width="92" height="92" loadDisplayMode="scaleToFit" uri="pkg:/images/logo.png" />
      <Rectangle translation="[181,584]" width="104" height="24" color="0xE53935FF">
        <Poster translation="[9,8]" width="8" height="8" uri="pkg:/images/dot.png" />
        <Label id="liveLabel" translation="[22,0]" width="80" height="24" vertAlign="center" text="AO VIVO" color="0xFFFFFFFF" />
      </Rectangle>
      <Label id="chLabel" translation="[298,584]" width="500" height="24" vertAlign="center" text="CANAL SOLO FÉRTIL" color="0xFFFFFF99" />
      <Label id="progTitle" translation="[181,610]" width="800" height="48" vertAlign="center" color="0xFFFFFFFF" />
      <Group id="epgRow" translation="[181,658]" visible="false">
        <Label id="progTime" translation="[0,0]" width="180" height="26" vertAlign="center" color="0xFFFFFFE6" />
        <Rectangle translation="[190,11]" width="140" height="4" color="0xFFFFFF40" />
        <Rectangle id="progBar" translation="[190,11]" width="0" height="4" color="0xFFC300FF" />
        <Label id="nextTag" translation="[350,0]" width="100" height="26" vertAlign="center" text="A SEGUIR" color="0xFFC300FF" />
        <Label id="progNext" translation="[458,0]" width="310" height="26" vertAlign="center" color="0xFFFFFFCC" />
      </Group>
      <Poster translation="[990,566]" width="46" height="24" uri="pkg:/images/key_ok.png" />
      <Label id="h1" translation="[1044,566]" width="172" height="24" vertAlign="center" text="Informações" color="0xFFFFFFCC" />
      <Poster translation="[990,596]" width="46" height="24" uri="pkg:/images/key_right.png" />
      <Label id="h2" translation="[1044,596]" width="172" height="24" vertAlign="center" text="Programação" color="0xFFFFFFCC" />
      <Poster translation="[990,626]" width="46" height="24" uri="pkg:/images/key_play.png" />
      <Label id="h3" translation="[1044,626]" width="172" height="24" vertAlign="center" text="Pausar" color="0xFFFFFFCC" />
      <Poster translation="[990,656]" width="46" height="24" uri="pkg:/images/key_back.png" />
      <Label id="h4" translation="[1044,656]" width="172" height="24" vertAlign="center" text="Sair" color="0xFFFFFFCC" />
    </Group>

    <!-- Grade de programação -->
    <GuideView id="guide" visible="false" />

    <!-- Pausa -->
    <Group id="pausedGroup" visible="false">
      <Rectangle translation="[0,0]" width="1280" height="720" color="0x00000066" />
      <Rectangle translation="[596,290]" width="26" height="90" color="0xFFFFFFFF" />
      <Rectangle translation="[658,290]" width="26" height="90" color="0xFFFFFFFF" />
      <Label id="pausedText" translation="[240,400]" width="800" height="40" horizAlign="center" text="Pausado · aperte OK para continuar" color="0xFFFFFFFF" />
    </Group>

    <!-- Erro / reconexão -->
    <Group id="errorGroup" visible="false">
      <Rectangle translation="[0,0]" width="1280" height="720" color="0x030905FF" />
      <Poster translation="[0,0]" width="1280" height="720" loadDisplayMode="scaleToFit" uri="pkg:/images/splash_hd.jpg" opacity="0.10" />
      <Poster translation="[605,236]" width="70" height="70" loadDisplayMode="scaleToFit" uri="pkg:/images/logo.png" />
      <Label id="errTitle" translation="[140,330]" width="1000" height="40" horizAlign="center" vertAlign="center" text="Não foi possível carregar a transmissão" color="0xFFFFFFFF" />
      <Label id="errReason" translation="[140,374]" width="1000" height="26" horizAlign="center" vertAlign="center" color="0xFFFFFF80" />
      <Label id="errRetry" translation="[140,414]" width="1000" height="32" horizAlign="center" vertAlign="center" color="0xFFFFFFFF" />
      <Label id="errHint" translation="[140,452]" width="1000" height="26" horizAlign="center" vertAlign="center" text="Aperte OK para tentar agora" color="0xFFFFFF80" />
    </Group>

    <!-- Tela de abertura: arte do canal + "Conectando..." no canto -->
    <Group id="splash" visible="true">
      <Poster id="splashImg" translation="[0,0]" width="1280" height="720" loadDisplayMode="scaleToZoom" uri="pkg:/images/splash_hd.jpg" />
      <Poster id="spinner" translation="[1070,34]" width="32" height="32" uri="pkg:/images/spinner.png" scaleRotateCenter="[16,16]" />
      <Label id="splashText" translation="[1112,34]" width="110" height="32" vertAlign="center" text="Conectando..." color="0xFFFFFFE6" />
      <Animation id="spinAnim" duration="1.1" repeat="true" easeFunction="linear">
        <FloatFieldInterpolator key="[0.0, 1.0]" keyValue="[0.0, 6.2832]" fieldToInterp="spinner.rotation" />
      </Animation>
    </Group>

    <!-- Sem internet -->
    <Group id="netGroup" visible="false">
      <Rectangle translation="[0,0]" width="1280" height="720" color="0x030905FF" />
      <Poster translation="[0,0]" width="1280" height="720" loadDisplayMode="scaleToFit" uri="pkg:/images/splash_hd.jpg" opacity="0.10" />
      <Poster translation="[608,262]" width="64" height="64" uri="pkg:/images/net.png" />
      <Label id="netTitle" translation="[140,350]" width="1000" height="40" horizAlign="center" vertAlign="center" text="Sem conexão com a internet" color="0xFFFFFFFF" />
      <Label id="netText" translation="[240,400]" width="800" height="70" horizAlign="center" wrap="true" maxLines="3"
             text="Verifique o cabo de rede ou o Wi-Fi da TV.&#10;A transmissão volta sozinha assim que a conexão for restabelecida." color="0xFFFFFFB3" />
    </Group>

    <Timer id="countTimer" duration="1" repeat="true" />
    <Timer id="hideTimer" duration="6" repeat="false" />
    <Timer id="tickTimer" duration="15" repeat="true" />
    <Timer id="epgTimer" duration="1800" repeat="true" />
    <Timer id="netTimer" duration="5" repeat="true" />
    <Timer id="launchTimer" duration="10" repeat="false" />
  </children>
</component>
